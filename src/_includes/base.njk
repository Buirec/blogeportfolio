<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | Cerbloge</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="icon" href="/img/cerb.png" type="image/png">
</head>

<body class="bg-teal min-h-screen p-3 sm:p-10">

  <div class="win-window mx-auto max-w-2xl">

    <div class="win-titlebar">
      <span>Cerbloge - {{ title }}</span>
      <span aria-hidden="true">
        <span class="win-btn">_</span><span class="win-btn">&#9633;</span><span class="win-btn">&#10005;</span>
      </span>
    </div>

    <nav class="win-menubar">
      <a href="/">Home</a>
      <a href="/games/">Games</a>
      <a href="/manga/">Manga</a>
      <a href="/about/">About</a>

      <div class="ml-auto flex items-center">
        <a class="flex items-center" href="https://bsky.app/profile/cerbuirus.bsky.social" target="_blank"
          rel="me noopener" aria-label="Bluesky" title="Bluesky">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path
              d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z" />
          </svg>
        </a>
        <a class="flex items-center" href="https://backloggd.com/u/Cerb/" target="_blank" rel="me noopener"
          aria-label="Backloggd" title="Backloggd">
          <svg viewBox="0 0 24 24" class="size-4.5 fill-none stroke-current stroke-3" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <path d="M7.5 3v14M7.5 3h5a3.5 3.5 0 0 1 0 7h-5M7.5 10h6a3.5 3.5 0 0 1 0 7h-6M5 21h14" />
          </svg>
        </a>
      </div>

    </nav>

    <div class="win-inset m-0.5 p-5 leading-relaxed">
      <main>
        {{ content | safe }}
      </main>
    </div>

    <div class="win-status m-0.5 mt-1">
      &copy; {{ page.date.getFullYear() }} cerbloge. made with eleventy.
    </div>

  </div>

  <script type="module" src="/js/main.js"></script>
</body>

</html>